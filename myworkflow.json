      "id": "dd6c66e0-2d67-4a32-92e3-e4c904773ecd",
      "name": "Edit Fields1"
    },
    {
      "parameters": {
        "jsCode": "const blog = $json.blog;\n\n// Extract title (between ** **)\nconst titleMatch = blog.match(/\\*\\*(.*?)\\*\\*/);\nconst title = titleMatch ? titleMatch[1] : \"AI Blog\";\n\n// Convert markdown to simple HTML\nlet content = blog\n  .replace(/\\*\\*(.*?)\\*\\*/g, '<h1>$1</h1>')\n  .replace(/### (.*)/g, '<h2>$1</h2>')\n  .replace(/\\n\\n/g, '<p></p>');\n\nreturn [\n  {\n    json: {\n      title: title,\n      content: content\n    }\n  }\n];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
