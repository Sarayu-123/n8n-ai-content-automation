    {
      "parameters": {
        "jsCode": "const title = $json.title;\nconst content = String($json.content);\n\n// Create short summary\nconst summary = content.replace(/<[^>]*>/g, '').slice(0, 150);\n\n// Generate social post\nconst post = `${title}\\n\\n${summary}...\\n\\n#AI #Automation #n8n #Tech`;\n\nreturn [\n  {\n    json: {\n      title,\n      content,\n      social_post: post\n    }\n  }\n];"
      },
